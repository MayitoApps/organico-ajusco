# Configuración de Envío de Correos - Orgánico Hotel Boutique Ajusco
# El formulario de contacto envía los mensajes a: artes.grupoorganico@gmail.com

# ------------------------------------------------------------------------------
# OPCIÓN A (Recomendada para producción en Vercel): RESEND
# Regístrate gratis en https://resend.com, crea una API Key y colócala aquí.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_1234567890abcdef
# EMAIL_FROM="Orgánico Hotel Boutique <contacto@organicohotelboutique.com>"

# ------------------------------------------------------------------------------
# OPCIÓN B: GMAIL SMTP con Contraseña de Aplicación
# Activa 2FA en tu cuenta de Google y genera una "Contraseña de aplicación":
# https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# SMTP_SERVICE=gmail
# SMTP_USER=artes.grupoorganico@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop

# ------------------------------------------------------------------------------
# CORREO DESTINATARIO (Por defecto ya apunta a artes.grupoorganico@gmail.com)
# ------------------------------------------------------------------------------
CONTACT_RECEIVER_EMAIL=artes.grupoorganico@gmail.com
